{
  "name": "Certificate",
  "type": "object",
  "properties": {
    "verification_request_id": {
      "type": "string"
    },
    "provider_user_id": {
      "type": "string"
    },
    "file_url": {
      "type": "string",
      "format": "uri"
    },
    "file_name": {
      "type": "string"
    }
  },
  "required": [
    "verification_request_id",
    "provider_user_id",
    "file_url",
    "file_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.provider_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}