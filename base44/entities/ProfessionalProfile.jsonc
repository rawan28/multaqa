{
  "name": "ProfessionalProfile",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string"
    },
    "full_legal_name": {
      "type": "string"
    },
    "gender": {
      "type": "string",
      "enum": [
        "male",
        "female",
        "other"
      ]
    },
    "profession_title": {
      "type": "string"
    },
    "academic_titles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "document_uri": {
            "type": "string"
          },
          "document_name": {
            "type": "string"
          }
        },
        "required": [
          "title",
          "document_uri"
        ]
      }
    },
    "specialties": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "documents": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "uri": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              },
              "required": [
                "uri",
                "name"
              ]
            }
          }
        },
        "required": [
          "name",
          "documents"
        ]
      }
    },
    "license_confirmed": {
      "type": "boolean",
      "default": false
    },
    "provider_user_id": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": false
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "pending_verification",
        "verified",
        "rejected"
      ],
      "default": "pending_verification"
    },
    "verified_at": {
      "type": "string"
    },
    "verified_by_admin_id": {
      "type": "string"
    },
    "rejection_reason": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "years_experience": {
      "type": "number",
      "minimum": 0
    },
    "appointment_mode": {
      "type": "string",
      "enum": [
        "online",
        "in_person",
        "both"
      ]
    },
    "session_fee": {
      "type": "number",
      "minimum": 0
    },
    "license_number": {
      "type": "string"
    },
    "work_days": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "sunday",
          "monday",
          "tuesday",
          "wednesday",
          "thursday",
          "friday",
          "saturday"
        ]
      }
    },
    "work_hours": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "day": {
            "type": "string",
            "enum": [
              "sunday",
              "monday",
              "tuesday",
              "wednesday",
              "thursday",
              "friday",
              "saturday"
            ]
          },
          "start": {
            "type": "string"
          },
          "end": {
            "type": "string"
          }
        },
        "required": [
          "day",
          "start",
          "end"
        ]
      }
    },
    "min_age": {
      "type": "number",
      "minimum": 0,
      "maximum": 120
    },
    "max_age": {
      "type": "number",
      "minimum": 0,
      "maximum": 120
    },
    "accepting_new_patients": {
      "type": "boolean",
      "default": true
    },
    "offers_mentorship": {
      "type": "boolean",
      "default": false
    },
    "profile_image_url": {
      "type": "string",
      "format": "uri"
    },
    "website": {
      "type": "string",
      "format": "uri"
    },
    "accessibility": {
      "type": "string"
    },
    "directions": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "professional_associations": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    }
  },
  "required": [
    "full_name",
    "full_legal_name",
    "profession_title",
    "license_number",
    "verification_status",
    "provider_user_id",
    "is_active",
    "location",
    "years_experience",
    "appointment_mode"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "$and": [
            {
              "data.verification_status": "verified"
            },
            {
              "data.is_active": true
            }
          ]
        },
        {
          "data.provider_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "data.provider_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}