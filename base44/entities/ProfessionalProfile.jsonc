{
  "name": "ProfessionalProfile",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "years_experience": {
      "type": "number",
      "minimum": 0
    },
    "appointment_mode": {
      "type": "string",
      "enum": [
        "online",
        "in_person",
        "both"
      ]
    },
    "specialty": {
      "type": "string"
    },
    "license_number": {
      "type": "string"
    },
    "work_days": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "sunday",
          "monday",
          "tuesday",
          "wednesday",
          "thursday",
          "friday",
          "saturday"
        ]
      }
    },
    "accepting_new_patients": {
      "type": "boolean",
      "default": true
    },
    "profile_image_url": {
      "type": "string",
      "format": "uri"
    },
    "website": {
      "type": "string",
      "format": "uri"
    },
    "accessibility": {
      "type": "string"
    },
    "directions": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    }
  },
  "required": [
    "full_name",
    "location",
    "years_experience",
    "appointment_mode",
    "specialty",
    "license_number"
  ]
}