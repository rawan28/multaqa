{
  "name": "ProfessionalProfile",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string"
    },
    "full_legal_name": {
      "type": "string"
    },
    "gender": {
      "type": "string",
      "enum": [
        "male",
        "female",
        "other"
      ]
    },
    "profession": {
      "type": "string",
      "enum": [
        "psychologist",
        "social_worker",
        "psychiatrist",
        "clinical_criminologist",
        "art_therapist"
      ]
    },
    "second_profession_name": {
      "type": "string"
    },
    "provider_user_id": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": false
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "pending_verification",
        "verified",
        "rejected"
      ],
      "default": "pending_verification"
    },
    "verified_at": {
      "type": "string"
    },
    "verified_by_admin_id": {
      "type": "string"
    },
    "rejection_reason": {
      "type": "string"
    },
    "base_license_number": {
      "type": "string"
    },
    "sub_specialty": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "years_experience": {
      "type": "number",
      "minimum": 0
    },
    "appointment_mode": {
      "type": "string",
      "enum": [
        "online",
        "in_person",
        "both"
      ]
    },
    "specialty": {
      "type": "string"
    },
    "license_number": {
      "type": "string"
    },
    "work_days": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "sunday",
          "monday",
          "tuesday",
          "wednesday",
          "thursday",
          "friday",
          "saturday"
        ]
      }
    },
    "accepting_new_patients": {
      "type": "boolean",
      "default": true
    },
    "offers_mentorship": {
      "type": "boolean",
      "default": false
    },
    "profile_image_url": {
      "type": "string",
      "format": "uri"
    },
    "website": {
      "type": "string",
      "format": "uri"
    },
    "accessibility": {
      "type": "string"
    },
    "directions": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "professional_associations": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    }
  },
  "required": [
    "full_name",
    "full_legal_name",
    "profession",
    "license_number",
    "verification_status",
    "provider_user_id",
    "is_active",
    "location",
    "years_experience",
    "appointment_mode",
    "specialty"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "$and": [
            {
              "data.verification_status": "verified"
            },
            {
              "data.is_active": true
            }
          ]
        },
        {
          "data.provider_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "data.provider_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}