{
  "name": "ProfessionalProfile",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string"
    },
    "profession": {
      "type": "string",
      "enum": [
        "psychologist",
        "psychotherapist",
        "nlp",
        "social_worker",
        "art_therapist",
        "parent_coach",
        "other"
      ]
    },
    "provider_user_id": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": false
    },
    "location": {
      "type": "string"
    },
    "years_experience": {
      "type": "number",
      "minimum": 0
    },
    "appointment_mode": {
      "type": "string",
      "enum": [
        "online",
        "in_person",
        "both"
      ]
    },
    "specialty": {
      "type": "string"
    },
    "license_number": {
      "type": "string"
    },
    "work_days": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "sunday",
          "monday",
          "tuesday",
          "wednesday",
          "thursday",
          "friday",
          "saturday"
        ]
      }
    },
    "accepting_new_patients": {
      "type": "boolean",
      "default": true
    },
    "offers_mentorship": {
      "type": "boolean",
      "default": false
    },
    "profile_image_url": {
      "type": "string",
      "format": "uri"
    },
    "website": {
      "type": "string",
      "format": "uri"
    },
    "accessibility": {
      "type": "string"
    },
    "directions": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    }
  },
  "required": [
    "full_name",
    "profession",
    "location",
    "years_experience",
    "appointment_mode",
    "specialty",
    "license_number",
    "provider_user_id",
    "is_active"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.is_active": true
        },
        {
          "data.provider_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "data.provider_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}