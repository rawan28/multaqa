{
  "name": "VerificationRequest",
  "type": "object",
  "properties": {
    "professional_profile_id": {
      "type": "string"
    },
    "provider_user_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending"
    },
    "admin_note": {
      "type": "string"
    }
  },
  "required": [
    "professional_profile_id",
    "provider_user_id",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.provider_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}