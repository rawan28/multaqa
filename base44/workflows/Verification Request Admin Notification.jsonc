{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "VerificationRequest"
    }
  },
  "name": "Verification Request Admin Notification",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "verification_request_admin_notification",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "notify_admin": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyAdminVerificationChange",
            "args": {
              "verification_request_id": "${ .trigger.entity_id }",
              "event_type": "${ .trigger.event_type }",
              "status": "${ .trigger.data.status }",
              "professional_profile_id": "${ .trigger.data.professional_profile_id }",
              "provider_user_id": "${ .trigger.data.provider_user_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "\u0625\u0634\u0639\u0627\u0631 \u0627\u0644\u0645\u062f\u064a\u0631",
            "description": "\u0625\u0631\u0633\u0627\u0644 \u0628\u0631\u064a\u062f \u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a \u0644\u0644\u0645\u062f\u064a\u0631"
          }
        }
      }
    ]
  },
  "description": "Notifies the admin by email when a VerificationRequest record is created or updated"
}